# Copy to mise.local.toml and adjust. Variables here are exported to `mise run` tasks.
[env]
# Path to the Unleash Java SDK checkout to benchmark (default: ../../Unleash/unleash-java-sdk)
SDK_DIR = "../../Unleash/unleash-java-sdk"

# Optional: fetch toggles from a real Unleash instance instead of the bundled bootstrap file.
# UNLEASH_URL = "https://app.unleash-hosted.com/demo/api"
# UNLEASH_API_KEY = "default:development.<token>"
# UNLEASH_PROJECT = "default"
